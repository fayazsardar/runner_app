# Vercel server-side environment only. Never use the VITE_ prefix for secrets.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=runner
# Use separate namespaces for preview and production when sharing a database.
RUNNER_NAMESPACE=runner-production
VENUE_TIME_ZONE=Europe/London
